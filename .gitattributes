# Normalise everything to LF in the repo and on checkout, so a Windows
# working copy and a Linux CI runner agree. Overrides core.autocrlf.
* text=auto eol=lf

# Windows batch files genuinely need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

*.db binary
*.png binary
*.jpg binary
*.ico binary
